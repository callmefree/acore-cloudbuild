+inline char const* ZhConditionName(Condition c) {
+    static constexpr char const* names[] = {
+        "", "鏖战", "躁动", "绝境", "自满", "独行", "相依", "深入",
+        "漫游", "敌强", "争锋", "夜行", "日照", "转瞬", "定身", "鞍伤"
+    };
+    auto const i = static_cast<unsigned>(c);
+    return i < sizeof(names) / sizeof(names[0]) ? names[i] : "";
+}
+inline char const* ZhBoonName(Boon b) {
+    static constexpr char const* names[] = {
+        "", "狂怒", "治愈", "疾步", "启迪", "贪婪", "坚韧",
+        "复苏", "闪避", "无情", "磨砺", "野蛮", "不死", "幸运"
+    };
+    auto const i = static_cast<unsigned>(b);
+    return i < sizeof(names) / sizeof(names[0]) ? names[i] : "";
+}
+inline std::string ZhBoonClause(Boon b, uint8 magnitude) {
+    if (magnitude == 0) return "";
+    char const* benefit = nullptr;
+    switch (b) {
+    case Boon::BonusDamage: benefit = "造成的伤害"; break;
+    case Boon::BonusHealing: benefit = "受到的治疗"; break;
+    case Boon::BonusMoveSpeed: benefit = "移动速度"; break;
+    case Boon::BonusExperience: benefit = "获得的经验"; break;
+    case Boon::BonusMoney: benefit = "拾取的金币"; break;
+    case Boon::BonusMaxHealth: benefit = "最大生命值"; break;
+    case Boon::BonusRegen: benefit = "恢复速度"; break;
+    case Boon::BonusLoot: benefit = "物品掉落几率"; break;
+    default: return "";
+    }
+    return std::string(" 收益：") + benefit + "提高 " + std::to_string(static_cast<unsigned>(magnitude)) + "%。";
+}
+// These benefits are bound to a particular action or condition. The generic
+// BoonClause would incorrectly imply a permanent bonus for 14, 15 and 24.
+inline std::string ZhSpecificClause(uint16 id, uint8 magnitude) {
+    unsigned const n = static_cast<unsigned>(magnitude);
+    switch (id) {
+    case 14: return " 成功躲开落点后，移动速度提高 " + std::to_string(n ? n : 10) + "%，持续 5 秒。";
+    case 15: return " 每层狂乱使造成的伤害提高 " + std::to_string(n ? n : 6) + "%，最多叠加 5 层；受到伤害会清空层数。";
+    case 24: return " 独自行动时获得的经验提高 " + std::to_string(n ? n : 20) + "%。";
+    case 37: return n ? " 收益：逃脱的冷却时间缩短 " + std::to_string(n) + "%。" : "";
+    case 38: return n ? " 收益：20 码外的射击伤害提高 " + std::to_string(n) + "%。" : "";
+    case 40: return n ? " 收益：疾跑的冷却时间缩短 " + std::to_string(n) + "%。" : "";
+    case 42: return n ? " 收益：直接闪避 " + std::to_string(n) + "% 的近战攻击。" : "";
+    case 47: return n ? " 收益：防护恐惧结界的冷却时间缩短 " + std::to_string(n) + "%。" : "";
+    case 49: return n ? " 收益：亡者复生的冷却时间缩短 " + std::to_string(n) + "%。" : "";
+    case 56: return n ? " 收益：冰霜新星的冷却时间缩短 " + std::to_string(n) + "%。" : "";
+    case 68: return n ? " 收益：战斗中的法力恢复速度提高 " + std::to_string(n) + "%。" : "";
+    case 32: return n ? " 收益：圣光术的法力消耗降低 " + std::to_string(n) + "%。" : "";
+    default: return "";
+    }
+}
+}
