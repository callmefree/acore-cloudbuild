+// Local patch -- client rune resync ----------------------------------------
+//
+// A Hero is never a real Death Knight, so the client never brings a spent
+// rune back on its own, and the core never tells it to ("runes act as
+// cooldowns, and they don't need to send any data"). The mask packet the
+// module already sends only fires when the rune state CHANGES, so once the
+// client's copy is wrong the packet never comes again and the character can
+// not cast a rune spell until a relog. Resend the whole rune block -- and
+// the ready mask -- on a timer instead, so the client's copy is corrected
+// even when nothing changed on our side.
+//
+// Everything below is a switch, because this client field is a ratio the
+// client itself interprets and a rebuild costs half an hour while a reload
+// costs a second:
+//   ClasslessWildcard.Runes.ClientResync    (1) master switch
+//   ClasslessWildcard.Runes.ResyncPacket    (1) send SMSG_RESYNC_RUNES at all
+//   ClasslessWildcard.Runes.ResyncReadyByte (255) value meaning "ready"; 0 flips it
+//   ClasslessWildcard.Runes.MaskAll         (0) send mask 0x3F, i.e. claim every
+//                                               rune is usable, every push
+//   ClasslessWildcard.Runes.ConvertRefresh  (0) send SMSG_CONVERT_RUNE for each
+//                                               recovered rune (same type)
+//   ClasslessWildcard.Runes.ResyncDebug     (0) log every push to Logger.module
+//   ClasslessWildcard.Runes.RegenPermille   (100) PLAYER_RUNE_REGEN_x = v/1000.
+//       Player::InitRunes bails out before it ever sets this field for a
+//       character whose class is not DEATHKNIGHT, so a rune Hero carries a
+//       regen rate of 0 -- and if the client drives its own rune recovery
+//       from that field, its runes never come back no matter what we send.
+void PushClientRuneState(Player* player, char const* tag)
+{
+    if (player->getClass() == CLASS_DEATH_KNIGHT) // the client ticks runes itself
+        return;
+
+    bool const readyHigh =
+        sConfigMgr->GetOption<uint32>("ClasslessWildcard.Runes.ResyncReadyByte", 255) != 0;
+    bool const sendResync = sConfigMgr->GetOption<bool>("ClasslessWildcard.Runes.ResyncPacket", true);
+    bool const maskAll = sConfigMgr->GetOption<bool>("ClasslessWildcard.Runes.MaskAll", false);
+    bool const convert = sConfigMgr->GetOption<bool>("ClasslessWildcard.Runes.ConvertRefresh", false);
+    bool const debug = sConfigMgr->GetOption<bool>("ClasslessWildcard.Runes.ResyncDebug", false);
+
+    // A real Death Knight gets 0.1f here in Player::InitRunes, while a Hero
+    // returns from that function before the line is ever reached.
+    uint32 const regenPermille =
+        sConfigMgr->GetOption<uint32>("ClasslessWildcard.Runes.RegenPermille", 100);
+
+    uint8 readyMask = 0;
+    WorldPacket resync(SMSG_RESYNC_RUNES, 4 + MAX_RUNES * 2);
+    resync << uint32(MAX_RUNES);
+    for (uint8 i = 0; i < MAX_RUNES; ++i)
+    {
+        if (regenPermille)
+        {
+            float const want = float(regenPermille) / 1000.0f;
+            if (player->GetFloatValue(PLAYER_RUNE_REGEN_1 + i) != want)
+                player->SetFloatValue(PLAYER_RUNE_REGEN_1 + i, want);
+        }
+
+        uint32 const cooldown = player->GetRuneCooldown(i);
+        uint8 byte = readyHigh ? 255 : 0;
+        if (cooldown)
+        {
+            uint32 const base = player->GetRuneBaseCooldown(i, true);
+            uint32 const passed = (base > cooldown) ? (base - cooldown) : 0;
+            uint32 const elapsed = base ? uint32((uint64(passed) * 255) / base) : 0;
+            if (readyHigh)
+                byte = uint8(elapsed > 250 ? 250 : elapsed); // never call a rune ready from the clock
+            else
+                byte = uint8(elapsed < 5 ? 5 : 255 - elapsed); // and never from the other end either
+        }
+        else
+        {
+            readyMask |= uint8(1 << i);
+            if (convert)
+            {
+                // Converting a rune is what Blood Tap does, and the client
+                // hands the rune back for it; same type, so nothing changes
+                // on our side.
+                WorldPacket conv(SMSG_CONVERT_RUNE, 2);
+                conv << uint8(i);
+                conv << uint8(player->GetCurrentRune(i));
+                player->SendDirectMessage(&conv);
+            }
+        }
+
+        resync << uint8(player->GetCurrentRune(i));
+        resync << uint8(byte);
+    }
+
+    if (sendResync)
+        player->SendDirectMessage(&resync);
+
+    // The mask is the packet the client reads as "this rune is usable again";
+    // it goes last so it wins over the fractions above.
+    uint32 const mask = maskAll ? uint32(0x3F) : uint32(readyMask);
+    if (mask)
+    {
+        WorldPacket data(SMSG_ADD_RUNE_POWER, 4);
+        data << uint32(mask);
+        player->SendDirectMessage(&data);
+    }
+
+    if (debug)
+        LOG_INFO("module", "CW runes {} [{}] mask 0x{:02x} cd {},{},{},{},{},{} regen {} resync={} maskall={} convert={}",
+                 player->GetName(), tag, mask,
+                 player->GetRuneCooldown(0), player->GetRuneCooldown(1), player->GetRuneCooldown(2),
+                 player->GetRuneCooldown(3), player->GetRuneCooldown(4), player->GetRuneCooldown(5),
+                 player->GetFloatValue(PLAYER_RUNE_REGEN_1), sendResync, maskAll, convert);
+}
+} // namespace
