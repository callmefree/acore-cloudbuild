--- a/conf/mod_gauntlet.conf.dist
+++ b/conf/mod_gauntlet.conf.dist
@@ -105,6 +105,48 @@ Gauntlet.Announce = 1
 
 Gauntlet.PlayersOnly = 1
 
+#
+#    Gauntlet.ClassMask.Extra
+#        Description: Class bits, in the core's 1 << (class - 1) convention,
+#                     OR'd into every character's offer mask. A MechanicDef
+#                     carries a class mask, and the offer filter drops every
+#                     row whose mask does not intersect the character's class
+#                     -- so on a classless realm, where every character is one
+#                     base class but learns the other classes' abilities, the
+#                     whole Family::Class band is unreachable forever.
+#                     Widening the mask lets those rows be offered. Nothing
+#                     else changes: the character's class, the talent-tree
+#                     encoding and the core's own class checks all still read
+#                     Gauntlet's GetClass() and see the base class.
+#                     1535 is 1|2|4|8|16|32|64|128|256|1024 -- all ten real
+#                     class bits, which offers every class curse.
+#                     See Gauntlet.ClassMask.GatedOnly for the cost of that.
+#        Default:     0 - (stock: only the character's own class)
+#                     1535 - every class curse becomes offerable
+#
+
+Gauntlet.ClassMask.Extra = 0
+
+#
+#    Gauntlet.ClassMask.GatedOnly
+#        Description: Only meaningful while Gauntlet.ClassMask.Extra is not 0.
+#                     A class curse that names no gate of its own pays its boon
+#                     and never lands its curse on a character of another
+#                     class: "at 100 rage you lose your mind" is free to a
+#                     class with no rage, "only one totem may stand" is free to
+#                     a class with no totems. With this on, the widened mask
+#                     reaches only rows that declare requiresSpell or
+#                     requiresTree, and requiresSpell is then tested against
+#                     the abilities the character has actually learned -- so a
+#                     classless character is offered exactly the class curses
+#                     their kit can answer. Off, the widened mask means what
+#                     it says and every ungated class curse is a free boon.
+#        Default:     0 - the widened mask reaches every class row
+#                     1 - only rows that carry a gate of their own
+#
+
+Gauntlet.ClassMask.GatedOnly = 0
+
 #
 #    Gauntlet.Family.Spawn.Enable
 #        Description: Master switch for the Spawn family: mechanics that spawn
