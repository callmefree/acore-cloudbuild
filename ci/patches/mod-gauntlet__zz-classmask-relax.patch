         virtual uint8  GetTalentTree() const = 0;
 
-        // 1 << (class - 1), the core's getClassMask() convention.
-        uint32 GetClassMask() const { return 1u << (GetClass() - 1); }
+        // 1 << (class - 1), the core's getClassMask() convention. This is the
+        // mask the offer filter tests a MechanicDef::classMask against, and it
+        // is virtual because a realm may widen it: on a classless build every
+        // character is one base class while learning every other class's
+        // abilities, so no character ever satisfies a class curse's mask and
+        // the whole Family::Class band is unreachable. Widening this -- and
+        // nothing else -- lets those rows be offered without changing the
+        // class the character is, which is what the addon header, the talent
+        // encoding and the core's own class checks all still read.
+        virtual uint32 GetClassMask() const { return 1u << (GetClass() - 1); }
+
+        // The mask for the class the character actually is, which is
+        // GetClassMask() unless a realm widened it. A row that only matches
+        // through the widening is one the server cannot show bites this
+        // character; see RelaxedNeedsGate.
+        virtual uint32 GetOwnClassMask() const { return 1u << (GetClass() - 1); }
+
+        // True when a widened offer mask may reach only rows that carry a gate
+        // of their own (requiresSpell or requiresTree). A class curse with no
+        // such gate -- "at 100 rage you lose your mind", aimed at a warrior --
+        // is a card that pays its boon and never charges for it on a character
+        // of another class, so a realm that widens the mask for reach rather
+        // than for difficulty turns this on. Gauntlet.ClassMask.GatedOnly.
+        virtual bool RelaxedNeedsGate() const { return false; }
     };
 
     std::string FamilyName(Family f);
