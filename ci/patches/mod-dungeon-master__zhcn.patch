--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -9,3 +9,12 @@ set_property(
 set_property(
   GLOBAL APPEND PROPERTY ACORE_MODULE_TEST_INCLUDES
   "${CMAKE_CURRENT_LIST_DIR}/src")
+
+# --- zhcn: 源码内含 UTF-8 中文字串，必须让 MSVC 按 UTF-8 解析源文件与执行字符集 ---
+if(MSVC)
+  add_compile_options(/utf-8)
+  file(GLOB_RECURSE _zhcn_srcs "${CMAKE_CURRENT_LIST_DIR}/src/*.cpp")
+  if(_zhcn_srcs)
+    set_source_files_properties(${_zhcn_srcs} PROPERTIES COMPILE_OPTIONS "/utf-8")
+  endif()
+endif()
