# Copy to .env and adjust.  deploy.sh creates this automatically when missing.
#
# Image produced by .github/workflows/coa-linux-image.yml.
# If ghcr.io refuses an anonymous pull, build the image locally from the workflow
# artifact instead (./build-from-artifact.sh <tag>) and use:
#   COA_IMAGE=coa-server:local
COA_IMAGE=ghcr.io/callmefree/coa-server:latest

# MySQL root password for the coa-database container (generated by deploy.sh)
COA_DB_ROOT_PASSWORD=

# Kept for compatibility with earlier revisions; ./botcmd.sh drives the worldserver
# console directly, so no credentials are needed for it.
COA_SOAP_PASSWORD=

# Host port mappings
COA_DB_EXTERNAL_PORT=3307
COA_AUTH_EXTERNAL_PORT=3724
COA_WORLD_EXTERNAL_PORT=8085
COA_SOAP_EXTERNAL_PORT=7878
COA_RA_EXTERNAL_PORT=3443

# Address clients use for the realm, written into acore_auth.realmlist
COA_REALM_ADDRESS=192.168.1.176

# Account-registration site (the page that used to run on the old server at
# 192.168.1.89).  It runs as its own container and creates accounts in THIS realm's
# acore_auth, using a dedicated least-privilege MySQL account whose password is
# generated into webregister/context/Settings/database.json.
COA_REGISTER_ENABLE=1
COA_REGISTER_EXTERNAL_PORT=8090

# frp client (profile "tunnel").  frpc.toml is rendered on the host from the token
# that the old server and the VPS share - it is NOT committed.  The remote port must
# be inside the VPS frps allowPorts list; the VPS nginx vhost
# register.soulcore.asia then proxies 443 -> 127.0.0.1:<this port>.
COA_FRP_REGISTER_REMOTE_PORT=8091
