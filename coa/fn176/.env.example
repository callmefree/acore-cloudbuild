# Copy to .env and adjust.  deploy.sh creates this automatically when missing.
#
# Image produced by .github/workflows/coa-linux-image.yml
COA_IMAGE=ghcr.io/callmefree/coa-server:latest

# MySQL root password for the coa-database container (generated by deploy.sh)
COA_DB_ROOT_PASSWORD=

# Host port mappings
COA_DB_EXTERNAL_PORT=3307
COA_AUTH_EXTERNAL_PORT=3724
COA_WORLD_EXTERNAL_PORT=8085
COA_SOAP_EXTERNAL_PORT=7878
COA_RA_EXTERNAL_PORT=3443

# Address clients use for the realm, written into acore_auth.realmlist
COA_REALM_ADDRESS=192.168.1.176
